# ──────────────────────────────────────────────────────────────────────────
# LocalSight — environment configuration
# Copy to `.env` and change EVERY secret before any non-local deployment.
# The application REFUSES TO START if required secrets are missing/empty.
# ──────────────────────────────────────────────────────────────────────────

# Runtime mode: development | production
APP_ENV=development
APP_NAME=LocalSight
LOG_LEVEL=INFO

# Database. SQLite needs no server (default, zero-dependency local run).
# For production use PostgreSQL, e.g.:
#   DATABASE_URL=postgresql+psycopg://localsight:CHANGE_ME@postgres:5432/localsight
DATABASE_URL=sqlite:///./localsight.db

# ── SECRETS (NEVER commit real values) ────────────────────────────────────
# 32 url-safe base64 bytes for JWT signing. Generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
JWT_SECRET=CHANGE_ME_GENERATE_A_32_BYTE_BASE64_KEY

# 32 url-safe base64 bytes used as the Key-Encryption-Key (KEK) for
# envelope encryption of embeddings, snapshots and sensitive config.
MASTER_ENCRYPTION_KEY=CHANGE_ME_GENERATE_ANOTHER_32_BYTE_BASE64_KEY

# Comma-separated ALLOWED_CORS_ORIGINS (browsers only). Empty = same-origin only.
CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3000

# Comma-separated IPs/CIDRs the SSRF guard may permit for camera egress
# (e.g. your camera VLAN). Empty = block all private/loopback destinations.
SSRF_ALLOWLIST=

# ── Token / session policy ────────────────────────────────────────────────
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=7
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15

# ── Storage ───────────────────────────────────────────────────────────────
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
# For s3: STORAGE_S3_BUCKET, STORAGE_S3_ENDPOINT, STORAGE_S3_REGION, STORAGE_S3_PREFIX

# ── AI pipeline (reference detector runs without a GPU / model) ────────────
AI_DETECTOR=reference
AI_INFERENCE_FPS=5
AI_CONFIDENCE_THRESHOLD=0.45
AI_IOU_THRESHOLD=0.50
AI_MOTION_GATE_ENABLED=true
# Motion-gate v2 threshold: mean absolute frame delta in [0,1] below which a
# frame skips detection entirely. Raise for noisy outdoor scenes, lower for
# dim indoor scenes. 0.004 ≈ one intensity level of mean change (0-255).
AI_MOTION_THRESHOLD=0.004
AI_RECOGNIZE_INTERVAL_SEC=2.0
AI_SIMILARITY_THRESHOLD=0.85

# ── ONNX Runtime execution plan (A1: edge/INT8 tuning) ────────────────────
# Only used when AI_DETECTOR is onnx/openvino/tensorrt. Unset AI_DETECTOR_PROVIDER
# = auto (CUDA → CoreML → CPU). Pin AI_ORT_INTRA_THREADS when many cameras share
# one CPU box — ORT's default pool over-subscribes and slows every camera down.
# AI_DETECTOR_PROVIDER=TensorrtExecutionProvider,CUDAExecutionProvider
# AI_ORT_INTRA_THREADS=2
# AI_ORT_GRAPH_OPT=all
# AI_INFERENCE_WATCHDOG_SEC=15

# ── Disk-pressure pre-alarms (never let a full disk eat evidence) ──────────
DISK_WARN_PCT=0.80
DISK_CRITICAL_PCT=0.90

# ── Retention (days) ──────────────────────────────────────────────────────
RETENTION_RECORDINGS_DAYS=7
RETENTION_EVENTS_DAYS=30
RETENTION_SNAPSHOTS_DAYS=14
RETENTION_EMBEDDINGS_DAYS=90
RETENTION_AUDIT_DAYS=365

# ── Live view lifecycle ──────────────────────────────────────────────────
# Directory transcoded LL-HLS segments are written to and served read-only
# from /live-media. MUST match the mount if you change it.
LOCALSIGHT_LIVE_DIR=./data/live
# A transcode nobody has watched for this long is stopped automatically.
LOCALSIGHT_LIVE_IDLE_TIMEOUT_SEC=300
# Hard ceiling per transcode; still-active viewers get a fresh process.
LOCALSIGHT_LIVE_MAX_DURATION_SEC=14400

# ── Monitoring ────────────────────────────────────────────────────────────
# Static bearer token Prometheus presents when scraping /api/system/metrics.
# Empty = metrics require a logged-in session (dashboards only).
# Must match infrastructure/monitoring/prometheus.yml credentials.
METRICS_SCRAPE_TOKEN=

# Create a bootstrap admin on first run (disable after onboarding).
# The app REFUSES TO START with the placeholder or a weak value here — set a
# strong (≥12 chars) initial password before first boot; gen_env.py mints one.
BOOTSTRAP_ADMIN_EMAIL=admin@localsight.local
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
